# Supabase — העתיקו קובץ זה ל-.env ומלאו מהפרויקט (Project Settings → API).
# ה-.env עצמו ב-.gitignore ולא נכנס ל-git. המפתח כאן הוא publishable/anon בלבד.
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# מפתח ה-service_role (עוקף RLS) נשמר אך ורק ב-.env.local (ראו .env.local.example)
# ומשמש רק סקריפטים אדמיניסטרטיביים (npm run reset:patient). לעולם לא ב-.env ולא ב-git.
