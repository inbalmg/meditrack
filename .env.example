# Supabase — העתיקו קובץ זה ל-.env ומלאו מהפרויקט (Project Settings → API).
# ה-.env עצמו ב-.gitignore ולא נכנס ל-git. המפתח כאן הוא publishable/anon בלבד.
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# מפתח ה-service_role (עוקף RLS) נשמר אך ורק ב-.env.local (ראו .env.local.example)
# ומשמש רק סקריפטים אדמיניסטרטיביים (npm run reset:patient). לעולם לא ב-.env ולא ב-git.

# Make.com — כתובת ה-Custom Webhook (שלב 3, פרויקט מתגלגל). מטופל חדש שמסיים אונבורדינג
# שולח POST עם name/phone/email/source. ריק/חסר = לא נשלח ליד (no-op) והאונבורדינג עובד כרגיל.
VITE_MAKE_WEBHOOK_URL=

# n8n Front-Desk Chat (שלב 4, פרויקט מתגלגל) — כתובת ה-chat webhook של סוכן ה-AI.
# מפעיל את כפתור "שיחה עם הבוט" בפורטל המטופל. DEV בלבד: הכפתור עטוף גם ב-import.meta.env.DEV
# ולכן נמחק לגמרי מ-build של production. ריק/חסר = הכפתור לא מופיע (no-op).
# לדוגמה (cloudflared): https://<tunnel>.trycloudflare.com/webhook/meditrack-frontdesk-chat/chat
VITE_N8N_CHAT_URL=
