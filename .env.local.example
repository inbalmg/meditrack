# Local-only secrets — copy to .env.local (gitignored) and fill from Supabase.
# Used ONLY by admin scripts (npm run reset:patient), never by the frontend/build.
#
# SUPABASE_SERVICE_ROLE_KEY bypasses RLS — treat it like a password. Never commit it,
# never expose it to the client, never put it in .env (which ships to the Vite build).
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...service_role...
# Optional — falls back to VITE_SUPABASE_URL from .env when omitted.
# SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
